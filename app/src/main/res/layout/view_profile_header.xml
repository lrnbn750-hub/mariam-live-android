<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/profileHeaderRoot"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="vertical"
    android:clipChildren="false"
    android:clipToPadding="false"
    android:paddingTop="4dp"
    android:paddingBottom="22dp">

    <!-- Top bar: music | brand | settings -->
    <LinearLayout
        android:id="@+id/profileHeaderTopBar"
        android:layout_width="match_parent"
        android:layout_height="48dp"
        android:orientation="horizontal"
        android:gravity="center_vertical"
        android:layoutDirection="ltr"
        android:paddingStart="16dp"
        android:paddingEnd="16dp">

        <ImageView
            android:id="@+id/profileHeaderSupport"
            android:layout_width="40dp"
            android:layout_height="40dp"
            android:padding="10dp"
            android:src="@drawable/ic_header_music"
            android:background="@drawable/profile_header_glass_button"
            android:clickable="true"
            android:focusable="true"
            android:contentDescription="الموسيقى" />

        <View android:layout_width="0dp" android:layout_height="1dp" android:layout_weight="1" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="BAK LIVE"
            android:textColor="#087B59"
            android:textSize="15sp"
            android:textStyle="bold|italic"
            android:letterSpacing="0.14" />

        <View android:layout_width="0dp" android:layout_height="1dp" android:layout_weight="1" />

        <ImageView
            android:id="@+id/profileHeaderSettings"
            android:layout_width="40dp"
            android:layout_height="40dp"
            android:padding="9dp"
            android:src="@drawable/ic_header_settings"
            android:background="@drawable/profile_header_glass_button"
            android:clickable="true"
            android:focusable="true"
            android:contentDescription="الإعدادات" />
    </LinearLayout>

    <!-- Identity: name / ID / level on the left, animated avatar on the right -->
    <LinearLayout
        android:id="@+id/profileHeaderIdentityRow"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:minHeight="104dp"
        android:orientation="horizontal"
        android:gravity="center_vertical"
        android:layoutDirection="ltr"
        android:layout_marginTop="10dp"
        android:clipChildren="false"
        android:paddingStart="16dp"
        android:paddingEnd="14dp">

        <LinearLayout
            android:id="@+id/profileIdentityGroup"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:orientation="vertical"
            android:gravity="right|center_vertical"
            android:layoutDirection="ltr"
            android:layout_marginEnd="10dp">

            <LinearLayout
                android:id="@+id/profileHeaderNameRow"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:minHeight="30dp"
                android:orientation="horizontal"
                android:gravity="center_vertical"
                android:layoutDirection="rtl">

                <TextView
                    android:id="@+id/profileHeaderName"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:minHeight="30dp"
                    android:layoutDirection="rtl"
                    android:gravity="right|center_vertical"
                    android:singleLine="true"
                    android:ellipsize="end"
                    android:text="جارٍ تحميل الاسم..."
                    android:textColor="#17242A"
                    android:textSize="22sp"
                    android:textStyle="bold"
                    android:shadowColor="#00000000"
                    android:shadowDx="0"
                    android:shadowDy="0"
                    android:shadowRadius="0" />

            </LinearLayout>

            <LinearLayout
                android:id="@+id/profileHeaderIdRow"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="8dp"
                android:orientation="horizontal"
                android:gravity="center_vertical"
                android:layoutDirection="ltr">

                <LinearLayout
                    android:id="@+id/profileHeaderIdChip"
                    android:layout_width="wrap_content"
                    android:layout_height="26dp"
                    android:orientation="horizontal"
                    android:gravity="center_vertical"
                    android:paddingStart="8dp"
                    android:paddingEnd="10dp"
                    android:background="@drawable/profile_header_id_chip"
                    android:clickable="true"
                    android:focusable="true">

                    <ImageView
                        android:id="@+id/profileHeaderCopy"
                        android:layout_width="16dp"
                        android:layout_height="16dp"
                        android:padding="1dp"
                        android:src="@drawable/ic_profile_copy"
                        android:tint="#53656D"
                        android:contentDescription="نسخ رقم الحساب"
                        android:clickable="true"
                        android:focusable="true" />

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginStart="6dp"
                        android:text="ID:"
                        android:textColor="#53656D"
                        android:textSize="12sp" />

                    <TextView
                        android:id="@+id/profileHeaderUserId"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginStart="3dp"
                        android:text="..."
                        android:textColor="#17242A"
                        android:textStyle="bold"
                        android:textDirection="ltr"
                        android:textSize="13sp"
                        android:singleLine="true" />
                </LinearLayout>

                <com.mariam.live.LevelBadgeView
                    android:id="@+id/profileLevelBadge"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="2dp" />
            </LinearLayout>
        </LinearLayout>

        <com.mariam.live.AvatarFrameView
            android:id="@+id/profileHeaderAvatarSlot"
            android:layout_width="100dp"
            android:layout_height="100dp"
            android:clipChildren="false">

            <ImageView
                android:id="@+id/profileHeaderAvatar"
                android:layout_width="78dp"
                android:layout_height="78dp"
                android:layout_gravity="center"
                android:scaleType="centerCrop"
                android:src="@drawable/ic_profile_avatar_placeholder"
                android:background="@drawable/profile_header_avatar_circle"
                android:clipToOutline="true"
                android:contentDescription="الصورة الشخصية" />

            <ImageView
                android:id="@+id/profileHeaderEditAvatar"
                android:layout_width="28dp"
                android:layout_height="28dp"
                android:layout_gravity="bottom|start"
                android:layout_marginStart="4dp"
                android:layout_marginBottom="6dp"
                android:background="@drawable/profile_header_edit_badge"
                android:padding="6dp"
                android:src="@drawable/ic_profile_edit"
                android:tint="#FFFFFF"
                android:contentDescription="تعديل الصورة الشخصية" />
        </com.mariam.live.AvatarFrameView>
    </LinearLayout>

    <!-- Glass stats card -->
    <LinearLayout
        android:id="@+id/profileHeaderStats"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="18dp"
        android:layout_marginStart="16dp"
        android:layout_marginEnd="16dp"
        android:paddingTop="6dp"
        android:paddingBottom="6dp"
        android:orientation="horizontal"
        android:gravity="center"
        android:layoutDirection="ltr"
        android:background="@drawable/profile_header_stats_glass">

        <LinearLayout
            android:id="@+id/profileHeaderFansCell"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:minHeight="54dp"
            android:layout_weight="1"
            android:orientation="vertical"
            android:gravity="center"
            android:background="?android:attr/selectableItemBackground"
            android:clickable="true"
            android:focusable="true">
            <TextView android:id="@+id/profileHeaderFansCount" android:layout_width="match_parent" android:layout_height="wrap_content" android:gravity="center" android:singleLine="true" android:text="0" android:textColor="#17242A" android:textSize="19sp" android:textStyle="bold" />
            <TextView android:layout_width="match_parent" android:layout_height="wrap_content" android:gravity="center" android:layout_marginTop="2dp" android:text="المعجبون" android:textColor="#66777D" android:textSize="12sp" />
        </LinearLayout>

        <View android:layout_width="1dp" android:layout_height="26dp" android:background="#6689B9A8" />

        <LinearLayout
            android:id="@+id/profileHeaderFollowingCell"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:minHeight="54dp"
            android:layout_weight="1"
            android:orientation="vertical"
            android:gravity="center"
            android:background="?android:attr/selectableItemBackground"
            android:clickable="true"
            android:focusable="true">
            <TextView android:id="@+id/profileHeaderFollowingCount" android:layout_width="match_parent" android:layout_height="wrap_content" android:gravity="center" android:singleLine="true" android:text="0" android:textColor="#17242A" android:textSize="19sp" android:textStyle="bold" />
            <TextView android:layout_width="match_parent" android:layout_height="wrap_content" android:gravity="center" android:layout_marginTop="2dp" android:text="المتابعون" android:textColor="#53656D" android:textSize="12sp" />
        </LinearLayout>

        <View android:layout_width="1dp" android:layout_height="26dp" android:background="#6689B9A8" />

        <LinearLayout android:id="@+id/profileHeaderFriendsCell" android:layout_width="0dp" android:layout_height="wrap_content" android:minHeight="54dp" android:layout_weight="1" android:orientation="vertical" android:gravity="center" android:background="?android:attr/selectableItemBackground" android:clickable="true" android:focusable="true">
            <TextView android:id="@+id/profileHeaderFriendsCount" android:layout_width="match_parent" android:layout_height="wrap_content" android:gravity="center" android:singleLine="true" android:text="0" android:textColor="#17242A" android:textSize="19sp" android:textStyle="bold" />
            <TextView android:layout_width="match_parent" android:layout_height="wrap_content" android:gravity="center" android:layout_marginTop="2dp" android:text="الأصدقاء" android:textColor="#53656D" android:textSize="12sp" />
        </LinearLayout>

        <View android:layout_width="1dp" android:layout_height="26dp" android:background="#6689B9A8" />

        <LinearLayout android:layout_width="0dp" android:layout_height="wrap_content" android:minHeight="54dp" android:layout_weight="1" android:orientation="vertical" android:gravity="center">
            <TextView android:id="@+id/profileHeaderVisitorsCount" android:layout_width="match_parent" android:layout_height="wrap_content" android:gravity="center" android:singleLine="true" android:text="—" android:textColor="#17242A" android:textSize="19sp" android:textStyle="bold" />
            <TextView android:layout_width="match_parent" android:layout_height="wrap_content" android:gravity="center" android:layout_marginTop="2dp" android:text="الزوار" android:textColor="#53656D" android:textSize="12sp" />
        </LinearLayout>
    </LinearLayout>
</LinearLayout>
